@page "/about"
@using PortfolioSite.Models
@inject AppState State
@inject NavigationManager Nav
@implements IDisposable

<div class="about-page">
    <div class="page-header">
        <div class="page-label">@(State.Lang == "pl" ? "// o_mnie" : "// about")</div>
        <h1 class="page-title">@(State.Lang == "pl" ? "Kim jestem" : "Who I am")</h1>
    </div>

    <div class="about-grid">
        <div class="about-text">
            @if (State.Lang == "pl")
            {
                <p>Cześć, jestem <strong>Kuba</strong> - programista i student informatyki na Polsko-Japońskiej Akademii Technik Komputerowych. Skupiam się na ekosystemie .NET i rozwoju w chmurze AWS. Projektuję i buduję strony internetowe, oraz interesuję się AI/ML.</p>
                <p>Piszę głównie w <strong>C# / Blazor</strong>, ale mam też doświadczenie w Javie, Pythonie, C++ oraz projektowaniu relacyjnych baz danych i SQL.</p>
            }
            else
            {
                <p>Hey, I'm <strong>Kuba</strong> - a software developer and computer science student at the Polish-Japanese Academy of Information Technology. I focus on the .NET ecosystem and cloud development with AWS. I design and build websites, and have an interest in AI/ML.</p>
                <p>I mostly write in <strong>C# / Blazor</strong>, but I also have experience with Java, Python, C++, and relational database design with SQL.</p>
            }
        </div>

        <div class="about-skills">
            <div class="skills-label">Stack</div>

            @foreach (var group in SkillsData.All.GroupBy(s => s.Category))
            {
                <div class="skill-group">
                    <div class="skill-group-key">@CategoryLabel(group.Key)</div>

                    <div class="skill-tags">
                        @foreach (var skill in group)
                        {
                            <button class="hss" @onclick='() => Nav.NavigateTo("/works?tag=" + Uri.EscapeDataString(skill.Name))'>@skill.Name</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code
{
    protected override void OnInitialized()
        => State.OnChange += StateHasChanged;

    public void Dispose()
        => State.OnChange -= StateHasChanged;

    private string CategoryLabel(string key) => key switch {
        "backend"  => State.Lang == "pl" ? "Backend"   : "Backend",
        "frontend" => State.Lang == "pl" ? "Frontend"  : "Frontend",
        "tools"    => State.Lang == "pl" ? "Narzędzia" : "Tools",
        _          => key
    };
}
